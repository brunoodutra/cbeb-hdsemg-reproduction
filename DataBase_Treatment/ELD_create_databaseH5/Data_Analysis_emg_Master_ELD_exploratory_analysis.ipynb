    {
     "data": {
      "text/plain": [
       "\"downsample_processing = pp.ProcessingPipeline([\\n    # downsample\\n    pp.Downsample(params['sampling_frequency'],250),\\n])\\n\\nemg_data_downsample=downsample_processing(emg_data_df.values.T).T\\nemg_data_df=pd.DataFrame(data=emg_data_downsample,columns=emg_data_df.columns)\\nparams['sampling_frequency']=250\\nemg_data_df.shape\""
      ]
