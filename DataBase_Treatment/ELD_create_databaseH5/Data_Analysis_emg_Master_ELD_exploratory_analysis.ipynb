     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import numpy as np\n",
    "from scipy.signal import resample\n",
    "\n",
    "def downsample_signal(data,old_Fs, new_Fs):\n",
    "    downsample_factor = old_Fs//new_Fs\n",
    "    # Calcular a nova taxa de amostragem\n",
    "    fs_downsampled = params['sampling_frequency']/downsample_factor\n",
    "    # Aplicar downsample no sinal EEG\n",
    "    eeg_downsampled = resample(data, int(len(data) / downsample_factor))\n",
    "    return eeg_downsampled\n",
    "\n",
    "'''### uncomment to apply downsample version 1\n",
    "downsample_freq=1000\n",
    "emg_downsampled=downsample_signal(eeg_data_df.values,params['sampling_frequency'], downsample_freq)\n",
    "emg_data_df = pd.DataFrame(eeg_downsampled,columns=eeg_data_df.columns.values)\n",
    "params['sampling_frequency']=downsample_freq\n",
    "print('New data shape (samples, channels):',eeg_data_df.shape)'''"
   ]
  },
