    "cut= True\n",
    "#cut= False\n",
    "if cut:\n",
    "    # Selecting only the SSVEP stimultation interval \n",
    "    Nit=len(emg_data)\n",
    "    Ts=1/params['sampling_frequency']\n",
    "    T=np.arange(0,(Nit*Ts),Ts)\n",
    "\n",
    "    t_min = 0.3#10\n",
    "    t_max = T[-1]\n",
    "    \n",
    "    \n",
    "    t_min =0.3#9\n",
    "    t_max =T[-1]\n",
    "    plt.plot(emg_data[np.where(T>=t_min)[0][0]:np.where(T>=t_max)[0][0],:12])\n",
    "    plt.show()\n",
    "\n",
    "    emg_data=emg_data[np.where(T>=t_min)[0][0]:np.where(T>=t_max)[0][0],:]\n",
    "\n",
