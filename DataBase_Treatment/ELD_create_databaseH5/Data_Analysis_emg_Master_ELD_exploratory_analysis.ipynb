   "source": [
    "data_processing = pp.ProcessingPipeline([\n",
    "     pp.NormMinMax(axis=0,minimum=0, maximum=1),  \n",
    "])\n",
    "\n",
    "filter_processing = pp.ProcessingPipeline([\n",
    "    \n",
    "    # band pass\n",
    "    pp.HighPassFilter(10, params['sampling_frequency'], 3),\n",
    "    pp.LowPassFilter(450, params['sampling_frequency'], 3),\n",
    "    pp.NotchFilter(60,60.0,params['sampling_frequency']),\n",
    "    pp.NotchFilter(120,60.0,params['sampling_frequency'])\n",
    "    #pp.BandPassFilter(4,100, params['sampling_frequency'], 3),## lee_2019 reference papaer\n",
    "    #pp.BandStopFilter(58, 63, params['sampling_frequency'], 3),\n",
    "    #pp.ChebyshevFilter(4,57,params['sampling_frequency'],3,2),\n",
    "    #pp.BandStopFilter(58, 63, params['sampling_frequency'], 3),\n",
    "\n",
    "    #pp.ButterworthNotchFilter(60,params['sampling_frequency'],3) \n",
    "]) \n",
    "\n",
    "\n",
    "emg_preprocessing = pp.ProcessingPipeline([\n",
    "    #pp.SampleTrimmer(axis=1, front=500, back=1),\n",
    "    pp.Retification(),\n",
    "    pp.EMGTKE(),\n",
    "    pp.MAFilter(31),\n",
    "    pp.NormMinMax(1,0,1)\n",
    "])"
   ]
