    "\n",
    "# four-step preprocessing\n",
    "emg_preprocessing = pp.ProcessingPipeline([\n",
    "    pp.SampleTrimmer(axis=1, front=1024, back=1024),\n",
    "    pp.Retification(),\n",
    "    pp.EMGTKE(),\n",
    "    pp.MAFilter(31)])\n",
    "\n",
    "force_preprocessing = pp.ProcessingPipeline([\n",
    "    pp.SampleTrimmer(axis=1, front=1024 + 1 + 30, back=1024 + 1)])\n",
    "\n",
    "# rms preprocessing\n",
